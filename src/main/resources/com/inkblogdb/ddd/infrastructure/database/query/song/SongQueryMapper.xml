<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkblogdb.ddd.infrastructure.database.query.song.SongQueryMapper">

    <select id="findAll" resultType="com.inkblogdb.ddd.infrastructure.database.query.song.SongQueryRecordEntity">
        SELECT
            m.id,
            m.name,
            m.level,
            m.publish_at,
            t.unlock_status,
            t.unlocked_at
        FROM
            t_player_songs t
        INNER JOIN
            m_songs m
        ON
            t.song_id = m.id
        WHERE
            t.player_id = #{playerId}
        ORDER BY
            m.publish_at ASC
    </select>

</mapper>
