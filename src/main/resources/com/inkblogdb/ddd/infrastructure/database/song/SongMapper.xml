<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkblogdb.ddd.infrastructure.database.song.SongMapper">

    <select id="findAll" resultType="com.inkblogdb.ddd.infrastructure.database.song.SongRecordEntity">
        SELECT
            id,
            name,
            level,
            publish_at
        FROM
            songs
    </select>

</mapper>
