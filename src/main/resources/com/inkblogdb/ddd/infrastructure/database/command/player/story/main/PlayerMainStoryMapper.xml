<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkblogdb.ddd.infrastructure.database.command.player.story.main.PlayerMainStoryMapper">

    <select id="findById" resultType="com.inkblogdb.ddd.infrastructure.database.command.player.story.main.PlayerMainStoryRecordEntity">
        SELECT
            player_id,
            story_id,
            read_at
        FROM
            t_player_main_stories
        WHERE
            player_id = #{playerId} AND
            story_id = #{storyId}
    </select>

</mapper>
