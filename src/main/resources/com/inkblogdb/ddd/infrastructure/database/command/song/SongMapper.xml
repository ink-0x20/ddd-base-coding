<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkblogdb.ddd.infrastructure.database.command.song.SongMapper">

    <select id="findById" resultType="com.inkblogdb.ddd.infrastructure.database.command.song.SongRecordEntity">
        SELECT
            id,
            name,
            easy_level,
            normal_level,
            hard_level,
            expert_level,
            unlock_type,
            unlock_target_id,
            unlock_quantity,
            publish_at
        FROM
            m_songs
        WHERE
            id = #{songId}
    </select>

</mapper>
